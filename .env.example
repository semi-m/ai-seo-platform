# Required to replace demo data. OAuth apps for Google; API keys for the rest.
# Do not put secrets in git.

# Google Search Console (OAuth) — your real queries and clicks
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Optional: who visits, including ChatGPT / Perplexity referrers
# Uses the same Google OAuth as Search Console
GA4_PROPERTY_ID=

# ChatGPT visibility (official API, with web search)
OPENAI_API_KEY=

# Spare writer / parser if OpenAI is down (not a ChatGPT.com substitute)
OPENROUTER_API_KEY=

# Not used in V1 (paid). Citations from ChatGPT, Gemini, DataForSEO AI Overviews.
# PERPLEXITY_API_KEY=

# Gemini answers
GEMINI_API_KEY=

# Rankings + keyword demand (pay as you go, not a Semrush seat)
DATAFORSEO_LOGIN=
DATAFORSEO_PASSWORD=
