# Required to replace demo data. OAuth apps for Google; API keys for the rest.
# Do not put secrets in git.

# Google login (business accounts) + later Search Console
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
AUTH_SECRET=
AUTH_URL=http://127.0.0.1:4731
AUTH_TRUST_HOST=true
FOUNDER_EMAIL=semi@revido.io

# SQLite database (created locally as data/lyra.db). Not committed.
# On Vercel this file does not persist — create a free Neon Postgres later
# and we will switch DATABASE_URL to that.
DATABASE_URL="file:../data/lyra.db"

# In Google Cloud, add this authorized redirect URI:
#   {AUTH_URL}/api/auth/callback/google
# Local: http://127.0.0.1:4731/api/auth/callback/google
# Vercel: https://YOUR-APP.vercel.app/api/auth/callback/google

# Optional: who visits, including ChatGPT / Perplexity referrers
# Uses the same Google OAuth as Search Console
GA4_PROPERTY_ID=

# ChatGPT visibility (official API, with web search)
OPENAI_API_KEY=

# Spare writer / parser if OpenAI is down (not a ChatGPT.com substitute)
OPENROUTER_API_KEY=

# Not used in V1 (paid). Citations from ChatGPT, Gemini, DataForSEO AI Overviews.
# PERPLEXITY_API_KEY=

# Gemini answers
GEMINI_API_KEY=

# Serper — DataForSEO replacement. 2,500 free credits, no card.
# https://serper.dev
SERPER_API_KEY=

# Optional free extras
BING_WEBMASTER_API_KEY=
TAVILY_API_KEY=
BRAVE_SEARCH_API_KEY=

# Optional spare: 100 free Google searches/day
# https://programmablesearchengine.google.com/controlpanel/create
GOOGLE_CSE_ID=
GOOGLE_CSE_API_KEY=

# Not used in V1 (paid rank index)
# DATAFORSEO_LOGIN=
# DATAFORSEO_PASSWORD=
